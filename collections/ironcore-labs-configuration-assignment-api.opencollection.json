            ],
            "params": [
              {
                "name": "kmsConfigId",
                "value": "",
                "type": "path",
                "description": "KMS Configuration ID"
              },
              {
                "name": "tenantId",
                "value": "",
                "type": "path",
                "description": "Tenant ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the assignment from the KMS configuration to the provided tenant. In order to succeed, the tenant must not own any of their own KMS configurations.\nThe primary configuration is used for encrypt calls. Setting this configuration to primary will un-set the previous primary.\nActive configurations are used for appropriate decrypt calls."
        },
