{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vendor API Bridge Configuration Assignment Tenant Secret API",
    "version": "3.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tenant Secret",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Tenant Secret List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:3000/api/1/tenants/secrets",
            "headers": [
              {
                "name": "icl-requestor-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "updatedSince",
                "value": "",
                "type": "query",
                "description": "RFC3339 timestamp"
              },
              {
                "name": "createdSince",
                "value": "",
                "type": "query",
                "description": "RFC3339 timestamp"
              },
              {
                "name": "secretType",
                "value": "",
                "type": "query",
                "description": "Tenant secret type to filter to"
              },
              {
                "name": "migrationStatus",
                "value": "",
                "type": "query",
                "description": "Tenant secret migration status to filter to"
              },
              {
                "name": "rotationStatus",
                "value": "",
                "type": "query",
                "description": "Tenant secret rotation status to filter to"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number to return"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of entries returned per page"
              },
              {
                "name": "sortDirection",
                "value": "",
                "type": "query",
                "description": "Direction to sort"
              },
              {
                "name": "sortColumn",
                "value": "",
                "type": "query",
                "description": "Column to use for sorting"
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Tenant provided ID, secret path, secret fingerprint, or KMS config ID to search for"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List secrets associated with the vendor's tenants"
        },
        {
          "info": {
            "name": "Tenant Secret Rotation Begin",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:3000/api/1/tenants/:tenantId/secrets/rotate/begin",
            "headers": [
              {
                "name": "icl-requestor-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "tenantId",
                "value": "",
                "type": "path",
                "description": "Tenant ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Begin rotation for a tenant secret. If `id` is specified, the assignment with that ID will be marked InRotation. If `secretType` and `secretPath` are specified, the tenant's Current secret matching those will be marked InRotation.\nInRotation secrets can still be used for decryption."
        },
        {
          "info": {
            "name": "Tenant Secret Rotation Commit",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:3000/api/1/tenants/:tenantId/secrets/rotate/commit",
            "headers": [
              {
                "name": "icl-requestor-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "tenantId",
                "value": "",
                "type": "path",
                "description": "Tenant ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Finish rotation for a tenant secret. If `id` is specified, the assignment with that ID will be marked Archived. If `secretType` and `secretPath` are specified, the tenant's InRotation secret matching those will be marked Archived.\nArchived secrets can still be used for decryption."
        }
      ]
    }
  ],
  "bundled": true
}